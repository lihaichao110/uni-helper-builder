# ==============================================================
# 数据库配置（PostgreSQL）
# 由 docker-compose.yml 中的 postgres 服务使用，并用于拼装
# api / worker / scheduler 容器的 DATABASE_URL 连接串
# ==============================================================

# PostgreSQL 初始化时自动创建的数据库名（必填）
POSTGRES_DB=uni_builder

# PostgreSQL 数据库用户名，同时用于健康检查命令（必填）
POSTGRES_USER=uni_builder

# PostgreSQL 数据库密码，docker-compose 会将其拼入 DATABASE_URL（必填，请使用强密码）
POSTGRES_PASSWORD=replace-with-a-long-database-password

# ==============================================================
# 缓存与任务队列配置（Redis / Celery）
# ==============================================================

# Redis 连接地址。后端用作 Celery 的 broker、构建日志实时推送（SSE）以及系统健康检查
# Docker Compose 部署时指向 redis 容器；默认值 redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ==============================================================
# 安全与认证配置（JWT / 凭据加密）
# ==============================================================

# JWT 签名密钥，用于登录令牌的签发与校验（必填，至少 32 字节随机串；生产环境务必替换）
JWT_SECRET=replace-with-at-least-32-random-bytes

# 构建凭据加密密钥（Fernet），用于加密存储用户填写的 Git 仓库访问令牌等敏感信息
# 必填；更换后已加密的凭据将无法解密，请妥善保管
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-random-secret

# ==============================================================
# 初始管理员配置
# 首次启动时若该用户不存在，后端会自动创建此管理员账号
# ==============================================================

# 初始管理员的用户名，默认 admin
BOOTSTRAP_ADMIN_USERNAME=admin

# 初始管理员的初始密码，首次登录后建议立即修改（必填，部署前务必替换）
BOOTSTRAP_ADMIN_PASSWORD=admin

# ==============================================================
# 构建流程配置（影响 worker 中 Docker 构建容器的行为）
# ==============================================================

# 执行 uni-app 构建所使用的 Docker 镜像名称及标签，需与 builder-image 目录中构建出的镜像一致
# 默认 uni-builder-core:4.15.0-r1
BUILDER_IMAGE=uni-builder-core:4.15.0-r1

# 每次构建允许使用的 CPU 核数（docker run 的 --cpus 限制），默认 2
BUILD_CPU_COUNT=2

# 每次构建允许使用的内存上限（docker run 的 --memory 限制），默认 4g
BUILD_MEMORY=4g

# 已完成构建产物（wgt 包）的保留数量，超出后由定时任务自动清理最旧的记录与产物，默认 10
BUILD_RETENTION_COUNT=10

# 构建前检查宿主磁盘剩余空间的最小值（单位 GB），不足时拒绝新构建任务，默认 2
MIN_FREE_DISK_GB=2

# ==============================================================
# 数据存储路径配置
# ==============================================================

# 宿主机数据根目录，docker-compose 将其挂载到容器内 /data
# 存放工作区、构建日志、构建产物等，生产环境默认 /opt/uni-builder/data（必填，需已存在且可写）
HOST_DATA_ROOT=/opt/uni-builder/data

# 容器内的数据根目录，需与 docker-compose 挂载点（右边为 /data）保持一致
# API 容器用它定位日志/产物目录，worker 另用它拼接挂载进构建容器的宿主机路径
DATA_ROOT=/data

# ==============================================================
# 前端与运行环境配置
# ==============================================================

# 前端访问地址，作为后端 CORS 允许的来源；Docker Compose 部署时为宿主机 8080 端口
# 默认 http://localhost:3000（本地开发）
FRONTEND_ORIGIN=http://localhost:8080

# 运行环境标识：production 时仅放行 FRONTEND_ORIGIN 的跨域请求，并为 Cookie 添加 secure 标记
# 可选值 development / production，默认 development
ENVIRONMENT=development
